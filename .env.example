# Copia este archivo a .env.local y rellena los valores. .env.local no se versiona.

# Clave de API de Resend (https://resend.com/api-keys). Solo se lee en el servidor.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Destinatario del formulario de contacto.
# Con el remitente de pruebas onboarding@resend.dev, Resend solo entrega al correo
# propietario de la cuenta; cualquier otro destinatario se rechaza (send_failed).
CONTACT_TO_EMAIL=tu-correo@ejemplo.com

# Remitente. Para usar un dominio propio hay que verificarlo antes en Resend.
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>

# Contraseña de la base de datos de Supabase.
SUPABASE_DB_PASSWORD=tu-contraseña-aquí
NEXT_PUBLIC_SUPABASE_URL=https://tu-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publicable
